# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LangSmith Configuration (for tracing and monitoring)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=greek-legal-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application Configuration
APP_NAME=Greek Legal Document RAG
ENVIRONMENT=development
LOG_LEVEL=INFO

# Paths
DOCUMENTS_DIR=documents
VECTORSTORE_DIR=vectorstore
LOGS_DIR=logs

# Vector Store Configuration (FAISS)
VECTORSTORE_NAME=greek_legal_docs
VECTORSTORE_PERSIST_DIRECTORY=vectorstore

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_PDF=1000
# Max tokens per embedding batch (OpenAI limit is 300k, using 250k for safety)
MAX_TOKENS_PER_EMBEDDING_BATCH=250000

# OCR Configuration (for scanned PDFs and images with CID codes)
# Uses OpenAI Vision API - no local installation required!
ENABLE_OCR=true
OCR_DPI=300  # Higher DPI = better quality but slower
OCR_MODEL=gpt-4o  # OpenAI vision model for OCR

# Retrieval Configuration
RETRIEVAL_TOP_K=20  # Number of documents to retrieve (increased for better coverage)
SIMILARITY_THRESHOLD=0.7

# Hybrid Search Configuration
SEMANTIC_WEIGHT=0.5
BM25_WEIGHT=0.5

# Multi-Agent Configuration
ENABLE_RAG_AGENT=true
ENABLE_TEMPORAL_AGENT=true

# Parallel Execution
MAX_CONCURRENT_AGENTS=3
AGENT_TIMEOUT_SECONDS=30

# LLM Configuration
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Language Settings
DEFAULT_LANGUAGE=el
ENCODING=utf-8

# Rate Limiting
MAX_RETRIES=3
RETRY_DELAY=2
